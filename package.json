{
  "name": "marking",
  "version": "1.0.0",
  "description": "",
  "main": "background.js",
  "type": "module",
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "postbuild": "node scripts/postbuild.ts",
    "watch": "npm-watch",
    "cp": "./scripts/copyfiles.sh",
    "add-hash": "scripts/add-hash.ts",
    "rename-to-mjs": "scripts/rename-js-to-mjs.ts",
    "build-lib": "scripts/esbuild.ts",
    "generate-bat": "node scripts/generate-start-bat.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "watch": {
    "build": {
      "patterns": [
        "extension",
        "doc"
      ],
      "extensions": "js,ts,tsx,css,html,png,json",
      "quiet": false
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "shared",
    "server",
    "api",
    "extension",
    "doc"
  ],
  "devDependencies": {
    "esbuild": "^0.27.2",
    "npm-watch": "^0.13.0",
    "typescript": "^7.0.2"
  }
}
