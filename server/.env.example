DOUBAO_API_KEY=
SSL_CERT=
SSL_KEY=
PORT=3000

# 企业微信通用凭证
WECOM_CORP_ID=
WECOM_CORP_SECRET=

# 登录客服账号（用于生成二维码，需使用 微信客服独立版 的 open_kfid）
LOGIN_KF_ID=

# 企业微信客服 — 回调配置（在企业微信后台「客服应用」-「回调配置」中设置）
WECOM_KF_TOKEN=          # Token，用于验证 URL
WECOM_KF_ENCODING_AES_KEY=  # EncodingAESKey，用于加解密消息

# 管理员用户名（用于登录充值面板）
ADMIN_USERNAME=

# 微信支付（v3 API）
WECHAT_PAY_APP_ID=              # 微信商户平台 — AppID
WECHAT_PAY_MCH_ID=              # 商户号
WECHAT_PAY_PRIVATE_KEY_PATH=    # 商户私钥文件路径（PEM）
WECHAT_PAY_CERT_SERIAL_NO=      # 商户证书序列号
WECHAT_PAY_API_V3_KEY=          # API v3 密钥（32字节，在商户平台设置）
WECHAT_PAY_NOTIFY_URL=          # 支付通知回调地址，如 https://your.domain/api/wechat-pay/_outNotify
WECHAT_PAY_PUB_KEY_PATH=        # 平台公钥文件路径（PEM），可选但建议设置（用于验证通知签名）
